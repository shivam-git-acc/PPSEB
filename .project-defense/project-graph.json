  "user_flows": [
    {
      "name": "Initialize, search and retrieve a medical record",
      "description": "A user initializes the toy parameter set, then submits a record, its keyword and a query keyword; the record is decrypted only when Verify accepts.",
      "steps": [
        { "actor": "user", "action": "Submit crypto parameters", "target": "React Parameters panel" },
        { "actor": "frontend", "action": "POST parameters", "target": "/api/init" },
        { "actor": "backend", "action": "Generate root keys and session values", "target": "PPSEB initialization" },
        { "actor": "user", "action": "Submit record and keyword/query", "target": "Happy Path tab" },
        { "actor": "frontend", "action": "POST record and keywords", "target": "/api/encrypt-search" },
        { "actor": "backend", "action": "Encrypt, create trapdoor, verify, then conditionally decrypt", "target": "PPSEB scheme" }
      ],
      "evidence": { "file": "backend\\api.py", "lines": [263, 297], "excerpt": "The request encrypts and verifies, and decrypts the record only on a match.", "status": "code-verified" }
    },
    {
      "name": "Demonstrate offline keyword guessing",
      "description": "Create a trapdoor for a chosen keyword and test public PEKS ciphertexts for dictionary candidates.",
      "steps": [
        { "actor": "user", "action": "Choose a secret keyword and candidate dictionary", "target": "KGA tab" },
        { "actor": "backend", "action": "Create the trapdoor with the session key", "target": "/api/attack/kga" },
        { "actor": "backend", "action": "Encrypt each public guess and test it against the trapdoor", "target": "KGA attack" },
        { "actor": "frontend", "action": "Display guesses, match and trace", "target": "KGA tab" }
