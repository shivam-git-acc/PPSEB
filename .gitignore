# Runtime artefacts stay out of the repository, but the two files the evaluation
# chapter depends on are committed: repro.json is regenerated by repro.sh
# (Requirement 8.4) and the static summary is displayable without re-running
# anything (Requirement 8.6). Ignore the directory's contents rather than the
# directory, or git cannot re-include a file inside it.
backend/results/*
!backend/results/repro.json
!backend/results/summary.md
!backend/results/demo_trace.json
!backend/results/screenshots/

# Node toolchains for the two auxiliary packages (M4 contracts, M6 circuit).
# Lockfiles are committed; the installed trees and every build output are not.
node_modules/
circuits/build/
circuits/fresh/
contracts/artifacts/
contracts/cache/

